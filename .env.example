# ScoreKind Environment Variables

# Application URL (used for trusted Stripe Checkout and Customer Portal return paths)
# Development: http://localhost:3000
# Production: https://your-domain.example
APP_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional alias for new Supabase publishable key format
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Privileged server-side key for administrative/test tasks (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Google Client ID for Google Identity Services (@react-oauth/google)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Stripe Configuration
# Server-only Secret Key (NEVER prefix with NEXT_PUBLIC_)
STRIPE_SECRET_KEY=sk_test_51...

# Server-only Webhook Secret for validating event signatures (NEVER prefix with NEXT_PUBLIC_)
STRIPE_WEBHOOK_SECRET=whsec_...

# Client-accessible Publishable Key (reserved for future client-side Stripe.js use)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Plan Configuration & Price IDs (REQUIRED: Server-side Stripe Price objects determine charges)
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...

# Display Configuration (Marketing display only; Stripe Price object determines actual charges)
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_AMOUNT=1299
NEXT_PUBLIC_STRIPE_YEARLY_PRICE_AMOUNT=11999
NEXT_PUBLIC_STRIPE_CURRENCY=inr
NEXT_PUBLIC_STRIPE_CURRENCY_SYMBOL=₹
